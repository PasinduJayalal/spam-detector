# Ignore virtual environment
venv/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# VS Code / PyCharm
.vscode/
.idea/

# Mac/Windows metadata
.DS_Store
Thumbs.db

# Data files (raw, processed) — keep folder but ignore files
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Models and vectorizers — keep folder but ignore files
models/*
!models/.gitkeep

# Large CSV/TSV files (if not in data/)
*.csv
*.tsv

# Logs
logs/
*.log

# Temporary files
tmp/
*.tmp

# Environment files
.env
.env.*
